# ============================================================
# Gold Trading System — BOOKMAP EDITION configuration
# BookMap (Rithmic real-time) data + AI brain + MT5 execution
# ============================================================
# This is the BookMap port of Gold-MT5. All data comes from BookMap platform
# via bookmap_addon.py -> ticks.csv -> bookmap_bridge_provider.py

# ---------- DATA: BookMap bridge (PRIMARY) ----------
# Live CME gold from BookMap Python addon (bookmap_addon.py) writing ticks.csv.
# Leave EMPTY to auto-detect: it finds ticks.csv in THIS SAME FOLDER first
# (set the addon's output to this folder — see docs/BOOKMAP_SETUP_GUIDE.md).
# Fallbacks: parent folder -> A:\gitHub\Rhitmic -> C:\BookMapBridge.
# Legacy NT_BRIDGE_FILE still works as alias.
DATA_SOURCE=bookmapbridge
BOOKMAP_BRIDGE_FILE=
# For backward compat, NT_BRIDGE_FILE is alias:
NT_BRIDGE_FILE=

# Data window kept in memory (seconds). 8h (28800) unlocks M15 timeframe vote
# and full Asian range; 2h (7200) gives M5 only.
BOOKMAP_WINDOW_SECONDS=28800
NT_WINDOW_SECONDS=28800

# How much of ticks.csv to re-read at startup (MB). Deeper history = ATR/MTF
# /order blocks / H1-H4 POC work immediately after restart.
BOOKMAP_CATCHUP_MB=64
NT_CATCHUP_MB=64

# Rotate ticks.csv at this size — BEFORE it grows too large. Chunk is gzipped
# into data/archive/ automatically (~8-10x smaller). Backtests accept .csv.gz.
BOOKMAP_ROTATE_MB=200
NT_ROTATE_MB=200

# Delete gzipped tick archives older than this many days. 0 = keep forever
# (recommended: archives are your backtest record; ~100-150 MB per day).
BOOKMAP_ARCHIVE_KEEP_DAYS=0
NT_ARCHIVE_KEEP_DAYS=0

# BookMap-specific
BOOKMAP_SYMBOL_FILTER=MGC
# Set to 1 to also write MBO (Market-By-Order) stream to mbo.csv for L3 votes (Phase 2)
BOOKMAP_WRITE_MBO=0
BOOKMAP_MBO_FILE=
# If trades side appears inverted, set to 1 to flip Buy/Sell
BOOKMAP_FLIP_SIDE=0

# The futures contract on your BookMap chart (root symbol matters)
DATA_SYMBOL=MGC 12-26

# ---------- EXECUTION: MT5 ----------
MT5_SYMBOL=XAUUSD
TRADING_SYMBOL=XAUUSD
BROKER_NAME=Pepperstone

# ============ PHASE 2: DRY RUN (safe default) ============
# 0 = analyse only, NEVER send an order.
# Flip to 1 ONLY for Phase 3 (demo trading) with MT5 open on DEMO account.
TRADING_ENABLED=0
ALLOW_LIVE_TRADING=0

EXECUTION_MODE=python

# ---------- AI (Gemini) ----------
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
# ... up to 20 supported: GEMINI_API_KEY_7 ... _20 are read automatically

AI_KEY_COOLDOWN_MINUTES=10
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash
AI_MIN_SIGNAL_STRENGTH=12
AI_MIN_INTERVAL_MINUTES=2
AI_MAX_CALLS_PER_DAY=0

CONFIDENCE_THRESHOLD=70
CONFIRM_ENABLED=1
CONFIRM_TIMEFRAMES=H1,M15,M5
MAX_SPREAD_PCT=0.05
ORDER_BLOCKS_ENABLED=1

COOLDOWN_MINUTES=15
MAX_TRADES_PER_DAY=30
RISK_PER_TRADE_PCT=0.1
MAX_LOT_SIZE=0.02

MAINTENANCE_ENABLED=1
LOG_RETENTION_DAYS=7
DECISIONS_LOG_MAX_ROWS=70000
OUTCOMES_LOG_MAX_ROWS=2000
RECORD_RETENTION_DAYS=30

MT5_SIGNAL_FILE=
#MT5_SIGNAL_FILE=C:\Users\Jafar\AppData\Roaming\MetaQuotes\Terminal\D0E8209F77C8CF37AD8BF550E51FF075\MQL5\Files\gold_signal.txt

NEWS_ENABLED=1
NEWS_CACHE_MINUTES=15
NEWS_MAX_HEADLINES=20
NEWS_TIMEOUT=8
NEWS_WARNING_MINUTES=30
NEWS_BLACKOUT_BEFORE_MINUTES=15
NEWS_BLACKOUT_AFTER_MINUTES=20
NEWS_WIDEN_STOP_MULT=1.5
NEWS_REDUCE_SIZE_PCT=0.5

MACRO_ENABLED=1
MACRO_CACHE_MINUTES=15
MACRO_TIMEOUT=8

PM_NEWS_PROTECT_ENABLE=1
PM_NEWS_PROTECT_MINUTES=10
PM_NEWS_PROTECT_MODE=tighten
PM_DAILY_FLATTEN_UTC=21:30
PM_ACTION_MAX_SPREAD_PCT=0.05

PM_PROFIT_LOCK_ENABLE=1
PM_PROFIT_LOCK_MIN_ATR=1.0
PM_PROFIT_GIVEBACK=0.5
PM_MOMENTUM_EXIT_ENABLE=1
PM_MOMENTUM_MIN_R=0.3
PM_MOMENTUM_SIGNAL=40
PM_TIME_STOP_MINUTES=60

# Optional future providers (unused now)
DATABENTO_API_KEY=
RITHMIC_USERNAME=
RITHMIC_PASSWORD=

# MT5 login (leave 0 to use already-running terminal)
MT5_LOGIN=0
MT5_TERMINAL_PATH=C:\Program Files\Pepperstone MetaTrader 5\terminal64.exe
