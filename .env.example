# ============================================================
# Gold Trading System — BOOKMAP EDITION configuration
# BookMap (Rithmic real-time) data + AI brain + MT5 execution
# ============================================================
# This is the BookMap port of Gold-MT5. All data comes from BookMap platform
# via bookmap_addon.py -> ticks.csv -> bookmap_bridge_provider.py

# ---------- DATA: BookMap bridge (PRIMARY) ----------
# Live CME gold from BookMap Python addon (bookmap_addon.py) writing ticks.csv.
# Leave EMPTY to auto-detect: it finds ticks.csv in THIS SAME FOLDER first
# (set the addon's output to this folder — see docs/BOOKMAP_SETUP_GUIDE.md).
# Fallbacks: parent folder -> A:\gitHub\Rhitmic -> C:\BookMapBridge.
# Legacy NT_BRIDGE_FILE still works as alias.
DATA_SOURCE=bookmapbridge
BOOKMAP_BRIDGE_FILE=
# For backward compat, NT_BRIDGE_FILE is alias:
NT_BRIDGE_FILE=

# Data window kept in memory (seconds). 8h (28800) unlocks M15 timeframe vote
# and full Asian range; 2h (7200) gives M5 only.
BOOKMAP_WINDOW_SECONDS=28800
NT_WINDOW_SECONDS=28800

# How much of ticks.csv to re-read at startup (MB). Deeper history = ATR/MTF
# /order blocks / H1-H4 POC work immediately after restart.
BOOKMAP_CATCHUP_MB=64
NT_CATCHUP_MB=64

# Rotate ticks.csv at this size — BEFORE it grows too large. Chunk is gzipped
# into data/archive/ automatically (~8-10x smaller). Backtests accept .csv.gz.
BOOKMAP_ROTATE_MB=200
NT_ROTATE_MB=200

# Delete gzipped tick archives older than this many days. 0 = keep forever
# (recommended: archives are your backtest record; ~100-150 MB per day).
BOOKMAP_ARCHIVE_KEEP_DAYS=0
NT_ARCHIVE_KEEP_DAYS=0

# BookMap-specific
BOOKMAP_SYMBOL_FILTER=GC
# Set to 1 to also write MBO (Market-By-Order) stream to mbo.csv for L3 votes (Phase 2) — recommended 1 for GC
BOOKMAP_WRITE_MBO=1
BOOKMAP_MAX_DEPTH_LEVELS=40  # v5.6 improved: 40 max (GC 20 real, MGC 10, future full depth), was 20
BOOKMAP_MBO_FILE=
# If trades side appears inverted, set to 1 to flip Buy/Sell
BOOKMAP_FLIP_SIDE=0

# The futures contract on your BookMap chart (root symbol matters) — v5.4.1 switched to GC (institutional)
DATA_SYMBOL=GC 12-26

# ---------- EXECUTION: MT5 ----------
MT5_SYMBOL=XAUUSD
TRADING_SYMBOL=XAUUSD
BROKER_NAME=Pepperstone

# ============ PHASE 2: DRY RUN (safe default) ============
# 0 = analyse only, NEVER send an order.
# Flip to 1 ONLY for Phase 3 (demo trading) with MT5 open on DEMO account.
TRADING_ENABLED=0
ALLOW_LIVE_TRADING=0

EXECUTION_MODE=python

# ---------- AI (Gemini) ----------
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
# ... up to 20 supported: GEMINI_API_KEY_7 ... _20 are read automatically

AI_KEY_COOLDOWN_MINUTES=10
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.6-flash
AI_MIN_SIGNAL_STRENGTH=12
AI_MIN_INTERVAL_MINUTES=2
AI_MAX_CALLS_PER_DAY=0

CONFIDENCE_THRESHOLD=70
CONFIRM_ENABLED=1
CONFIRM_TIMEFRAMES=H1,M15,M5
MAX_SPREAD_PCT=0.05
ORDER_BLOCKS_ENABLED=1

COOLDOWN_MINUTES=15
MAX_TRADES_PER_DAY=30
RISK_PER_TRADE_PCT=0.1
MAX_LOT_SIZE=0.02

MAINTENANCE_ENABLED=1
LOG_RETENTION_DAYS=7
DECISIONS_LOG_MAX_ROWS=70000
OUTCOMES_LOG_MAX_ROWS=2000
RECORD_RETENTION_DAYS=30

MT5_SIGNAL_FILE=
#MT5_SIGNAL_FILE=C:\Users\Jafar\AppData\Roaming\MetaQuotes\Terminal\D0E8209F77C8CF37AD8BF550E51FF075\MQL5\Files\gold_signal.txt

NEWS_ENABLED=1
NEWS_CACHE_MINUTES=15
NEWS_MAX_HEADLINES=20
NEWS_TIMEOUT=8
NEWS_WARNING_MINUTES=30
NEWS_BLACKOUT_BEFORE_MINUTES=15
NEWS_BLACKOUT_AFTER_MINUTES=20
NEWS_WIDEN_STOP_MULT=1.5
NEWS_REDUCE_SIZE_PCT=0.5

MACRO_ENABLED=1
MACRO_CACHE_MINUTES=15
MACRO_TIMEOUT=8

PM_NEWS_PROTECT_ENABLE=1
PM_NEWS_PROTECT_MINUTES=10
PM_NEWS_PROTECT_MODE=tighten
PM_DAILY_FLATTEN_UTC=21:30
PM_ACTION_MAX_SPREAD_PCT=0.05

PM_PROFIT_LOCK_ENABLE=1
PM_PROFIT_LOCK_MIN_ATR=1.0
PM_PROFIT_GIVEBACK=0.5
PM_MOMENTUM_EXIT_ENABLE=1
PM_MOMENTUM_MIN_R=0.3
PM_MOMENTUM_SIGNAL=40
PM_TIME_STOP_MINUTES=60

# ---------- v5.2 CRITICAL: L3 Whale + Regime Adaptive + AI Fallback + Basis ----------
# C1: L3 Whale detection
L3_WHALE_THRESHOLD=100
L3_WHALE_PROXIMITY_PCT=0.5
L3_WHALE_WEIGHT=1.5
SIGNAL_W_L3_WHALE=1.5

# C2: Regime-Adaptive weights
REGIME_ADAPTIVE=1
TREND_ADX_THRESHOLD=25
VOLATILITY_HIGH_MULT=1.5
RANGE_VWAP_WEIGHT=2.0

# C3: AI bottleneck & fallback
AI_TIMEOUT_SECONDS=20
AI_FALLBACK_ENABLED=1
AI_FALLBACK_STRENGTH=35
AI_FALLBACK_CONFIDENCE=70
AI_CACHE_MINUTES=5
AI_MAX_PROMPT_BARS=15
AI_MAX_HEADLINES=5

# C4: Basis risk futures vs spot
BASIS_MAX=50
BASIS_BUFFER_MULT=1.5
BASIS_WARN_PCT=1.0

# ---------- v5.3 MEDIUM: M1-M6 ----------
# M1 Footprint & Absorption
FOOTPRINT_ENABLED=1
ABSORPTION_WALL_SIZE=50
ABSORPTION_MIN_EVENTS=2
AGGRESSIVE_FROM_TICKS=1

# M2 Volatility-adjusted position sizing
VOL_ADJUSTED_LOTS=1
VOL_LOT_RISK_PCT=1.0
MIN_LOT_SKIP=1
VOL_ATR_FALLBACK_PCT=0.5

# M3 Iceberg & Spoof Detection (L3 Alpha)
ICEBERG_ENABLED=1
ICEBERG_MIN_REFILLS=3
ICEBERG_SAME_PRICE_TOL=0.10
SPOOF_ENABLED=1
SPOOF_CANCEL_SECONDS=2.0
SPOOF_SIZE_THRESHOLD=100
SIGNAL_W_ICEBERG=1.0
SIGNAL_W_SPOOF=0.8

# M4 Macro & News boost
NEWS_SENTIMENT_HIGH_WEIGHT=1.0
NEWS_SENTIMENT_LOW_WEIGHT=0.4
DXY_VETO_ENABLED=1
DXY_RISING_THRESHOLD_PCT=0.3
DXY_CORR_THRESHOLD=-0.15
SIGNAL_W_MACRO_HIGH=1.0

# M5 MBO archival
BOOKMAP_MBO_ROTATE_MB=100
BOOKMAP_MBO_ARCHIVE_KEEP_DAYS=0

# M6 TCA & Slippage
TCA_ENABLED=1
TCA_REPORT_DAYS=7
TCA_SLIPPAGE_THRESHOLD=0.5
TCA_ADJUST_SPREAD_MULT=1

# ---------- v5.4 LOW: L1-L6 BANK-GRADE ----------
# L1 Cross-Market Confirmation (GC, SI, DXY)
CROSS_MARKET_ENABLED=0
CROSS_MARKET_CONF_BOOST=15
GC_BRIDGE_FILE=
SI_BRIDGE_FILE=

# L2 Backtest L3 (auto-detects mbo.csv.gz)
BACKTEST_L3_ENABLED=1

# L3 Queue Position Model
QUEUE_POS_ENABLED=1
QUEUE_POS_THRESHOLD=0.7

# L4 Latency & Kill Switch
LATENCY_LOG_ENABLED=1
LATENCY_TARGET_MS=500
FLASH_CRASH_ENABLED=1
FLASH_CRASH_ATR_MULT=3.0
FLASH_CRASH_MINUTES=1.0

# L5 Reinforcement Learning from Trade Memory
RL_ENABLED=1
RL_LOSS_STREAK=3
RL_SIZE_REDUCE_PCT=50
RL_PAUSE_MINUTES=30

# ---------- v5.5 B2/B3/B6: ML + Smart Limit + Walk-Forward ----------
# B2 ML Self-Learning from trade_memory.json (boost winners +15% after 30+ trades)
ML_TRAINER_ENABLED=1
ML_MIN_TRADES=30
ML_WEIGHT_ADJUST_PCT=15.0

# B3 Smart Limit Queue — place limit at iceberg/support instead of market chase (off by default, enable after GC live verified)
LIMIT_ORDER_ENABLED=0
LIMIT_OFFSET_TICKS=1
LIMIT_TICK_SIZE=0.1
LIMIT_TIMEOUT_SECONDS=10
LIMIT_VOL_ADJUST=1
LIMIT_SPOOF_AVOID=1

# B6 Walk-Forward 30-day + Monte Carlo 1000 runs (tools/walk_forward.py)
WALK_FORWARD_DAYS=30
WALK_FORWARD_MONTE_CARLO=1000

# L6 Volatility Regime Position Manager (adaptive giveback)
PM_VOL_ADAPTIVE=1
PM_VOL_HIGH_GIVEBACK=0.30
PM_VOL_LOW_GIVEBACK=0.60
PM_VOL_HIGH_RANK=0.6
PM_VOL_LOW_RANK=0.3

# Optional future providers (unused now)
DATABENTO_API_KEY=
RITHMIC_USERNAME=
RITHMIC_PASSWORD=

# MT5 login (leave 0 to use already-running terminal)
MT5_LOGIN=0
MT5_TERMINAL_PATH=C:\Program Files\Pepperstone MetaTrader 5\terminal64.exe
